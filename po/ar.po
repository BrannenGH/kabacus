msgctxt "%1 is an amount, %2 an account, %3 the new reserve's name"
msgid "Set aside %1 from %2 into a new reserve, %3."
msgstr "ادّخر %1 من %2 في احتياطي جديد، %3."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is an amount, %2 and %3 accounts"
msgid "Move %1 from %2 to %3."
msgstr "انقل %1 من %2 إلى %3."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is an amount, %2 a card"
msgid "Pay %1 to %2 from its reserve."
msgstr "ادفع %1 لـ%2 من احتياطيها."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is a payee, %2 the total, %3 an account, %4 a person, %5 their share"
msgid "%1: %2 paid with %3; %4 owes %5 of it."
msgstr "%1: %2 دُفع بـ%3؛ %4 مدين بـ%5 منه."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is a payee"
msgid "Edit %1 in place. History keeps the old version."
msgstr "حرّر %1 في مكانه. يحتفظ السجل بالنسخة القديمة."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "Void it: add a reversal, dated today."
msgstr "ألغِه: أضف قيدًا عكسيًا بتاريخ اليوم."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is an account, %2 a date, %3 a balance"
msgid "Record that %1 matched the statement on %2: %3."
msgstr "سجّل أن %1 طابق الكشف في %2: %3."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%2 is a card"
msgid "Add the missing reserve lines to %1 transaction on %2, as one change."
msgid_plural "Add the missing reserve lines to %1 transactions on %2, as one change."
msgstr[0] "أضف أسطر الاحتياطي الناقصة إلى عمليات %2 (%1) كتغيير واحد."
msgstr[1] "أضف أسطر الاحتياطي الناقصة إلى عملية واحدة (%1) على %2 كتغيير واحد."
msgstr[2] "أضف أسطر الاحتياطي الناقصة إلى عمليتين (%1) على %2 كتغيير واحد."
msgstr[3] "أضف أسطر الاحتياطي الناقصة إلى %1 عمليات على %2 كتغيير واحد."
msgstr[4] "أضف أسطر الاحتياطي الناقصة إلى %1 عملية على %2 كتغيير واحد."
msgstr[5] "أضف أسطر الاحتياطي الناقصة إلى %1 عملية على %2 كتغيير واحد."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "the person a cost is split with"
msgid "Who"
msgstr "مَن"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "Their share can't be more than the total"
msgstr "لا يمكن أن تتجاوز حصتهم المجموع"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "The transaction"
msgstr "العملية"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "Choose at least one transaction"
msgstr "اختر عملية واحدة على الأقل"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is a card"
msgid "%1 has no reserve account"
msgstr "ليس لـ%1 حساب احتياطي"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is a transaction's payee"
msgid "%1 isn't missing reserve lines"
msgstr "لا تنقص %1 أسطرُ احتياطي"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is the new reserve's name"
msgid "kabacus-server didn't make the new reserve %1: it's older than this app. Update kabacus-server, or pick a reserve that exists."
msgstr "لم ينشئ kabacus-server الاحتياطي الجديد %1: إنه أقدم من هذا التطبيق. حدّث kabacus-server، أو اختر احتياطيًا موجودًا."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "This app, on another device"
msgstr "هذا التطبيق، على جهاز آخر"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "An external edit"
msgstr "تحرير خارجي"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "who made a change"
msgid "Someone"
msgstr "شخص ما"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "Nothing to save: the books already say this."
msgstr "لا شيء لحفظه: الدفاتر تقول هذا بالفعل."

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "The books still check out with this change"
msgstr "لا تزال الدفاتر سليمة مع هذا التغيير"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgctxt "%1 is a card"
msgid "%1 stays covered by its reserve"
msgstr "ما زال احتياطي %1 يغطّيها"

#: crates/kabacus-kde/src/writes.rs
#, kde-format
msgid "A card is missing its reserve lines; it will be flagged"
