set -eu
cd "$(dirname "$0")/.."
cargo build --locked --release --target wasm32-unknown-unknown -p kabacus-wasm
wasm-bindgen --target web --out-dir apps/kabacus-ui/public/wasm target/wasm32-unknown-unknown/release/kabacus_wasm.wasm
