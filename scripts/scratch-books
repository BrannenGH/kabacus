# Make throwaway synthetic books (never real books) in a new .kabacus file.
# Used by scripts/dev-server and scripts/scratch-server.
#   scripts/scratch-books target/scratch/books.kabacus
set -e
[ $# -eq 1 ] || { echo "usage: scripts/scratch-books FILE.kabacus" >&2; exit 2; }
books="$1"
[ ! -e "$books" ] || { echo "scripts/scratch-books: $books already exists" >&2; exit 1; }
mkdir -p "$(dirname "$books")"
seed=$(mktemp "$(dirname "$books")/scratch-commands.XXXXXX")
trap 'rm -f "$seed"' EXIT HUP INT TERM
cat > "$seed" <<'J'
[
  {"command":"declare_account","params":{"account":"liabilities:visa"}},
  {"command":"declare_account","params":{"account":"expenses:groceries"}},
  {"command":"declare_account","params":{"account":"expenses:household"}},
  {"command":"declare_account","params":{"account":"income:salary"}},
  {"command":"transaction.postings","params":{"date":"2026-01-01","description":"Opening","postings":[{"account":"assets:checking","amount":"2500.00"},{"account":"equity:opening"}]}},
  {"command":"transaction.spent","params":{"date":"2026-01-05","payee":"Corner Market","from":"assets:checking","for":"expenses:groceries","amount":"62.18"}},
  {"command":"transaction.postings","params":{"date":"2026-01-15","description":"Acme Payroll","postings":[{"account":"assets:checking","amount":"1800.00"},{"account":"income:salary"}]}}
]
J
scripts/dev cargo build -p kabacus-cli
scripts/dev target/dev/debug/kabacus-cli new "$books" --account assets:checking
scripts/dev target/dev/debug/kabacus-cli run "$seed" --books "$books" --save --allow-rewrites
