# Write throwaway synthetic books (never real books) into DIR as journals
# for kabacus-server's import: DIR/main.journal plus its includes. DIR must not exist yet or
# be empty. Used by scripts/scratch-server and the VS Code debug configs.
#   scripts/scratch-books target/scratch/books
set -e
[ $# -eq 1 ] || { echo "usage: scripts/scratch-books DIR" >&2; exit 2; }
books="$1"
mkdir -p "$books"
[ -z "$(ls -A "$books")" ] || { echo "scripts/scratch-books: $books is not empty" >&2; exit 1; }
cat > "$books/main.journal" <<'J'
commodity USD1000.00
include accounts.journal
include 2026.journal
J
cat > "$books/accounts.journal" <<'J'
account assets:checking      ; ynab-account:Everyday Checking
account liabilities:visa     ; ynab-account:Visa
account expenses:groceries   ; ynab-envelope:Groceries
account expenses:household   ; ynab-envelope:Household
account income:salary
account equity:opening
J
cat > "$books/2026.journal" <<'J'
2026-01-01 Opening
    assets:checking  2500.00 USD
    equity:opening

2026-01-05 Corner Market
    expenses:groceries  62.18 USD
    assets:checking

2026-01-15 Acme Payroll
    assets:checking  1800.00 USD
    income:salary
J
