"""Expose the pinned upstream collection in the project skill directories."""
import os
from pathlib import Path

root = Path(__file__).resolve().parent.parent
# bencium-design keeps each skill under <plugin>/skills/<name>. Only the
# UI skills are taken from the larger general collections.
vendors = {
    root / ".agents/vendor/claude-skills/skills": "**/SKILL.md",
    root / ".agents/vendor/ponytail/skills": "**/SKILL.md",
    root / ".agents/vendor/bencium-design": "*/skills/*/SKILL.md",
    root / ".agents/vendor/accesslint/plugins/accesslint/skills": "*/SKILL.md",
    root / ".agents/vendor/ui-ux-pro-max/.claude/skills": "ui-ux-pro-max/SKILL.md",
    root / ".agents/vendor/anthropic-skills/skills": "frontend-design/SKILL.md",
    root / ".agents/vendor/vercel-agent-skills/skills": tuple(
        f"{name}/SKILL.md"
        for name in (
            "web-design-guidelines",
            "react-best-practices",
            "composition-patterns",
            "react-native-skills",
        )
    ),
}

sources = {}
for vendor, patterns in vendors.items():
    if not vendor.is_dir():
        raise SystemExit("Run git submodule update --init --recursive first.")
    if isinstance(patterns, str):
        patterns = (patterns,)
    for source in sorted(s for pattern in patterns for s in vendor.glob(pattern)):
        name = source.parent.name
        if name in sources:
            raise SystemExit(f"Duplicate skill name: {name}")
        sources[name] = source.parent
if not sources:
    raise SystemExit("The upstream collection contains no skills.")

skills = root / ".agents/skills"
links = {skills / name: source for name, source in sources.items()}
links[root / ".claude/skills"] = skills
for link, source in links.items():
    if (link.exists() or link.is_symlink()) and not (
        link.is_symlink() and os.readlink(link) == os.path.relpath(source, link.parent)
    ):
        raise SystemExit(f"Refusing to replace existing skill entry: {link.relative_to(root)}")
for link, source in links.items():
    link.parent.mkdir(parents=True, exist_ok=True)
    if not link.is_symlink():
        link.symlink_to(os.path.relpath(source, link.parent), target_is_directory=True)
for link in skills.iterdir():
    if link.is_symlink() and link.name not in sources and any(
        os.readlink(link).startswith(os.path.relpath(vendor, skills) + "/") for vendor in vendors
    ):
        link.unlink()
print(f"Linked {len(sources)} skills.")
