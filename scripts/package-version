# Print the version the app's packages carry (scripts/build-packages,
# packaging/rpm/build-rpm): <major>.<minor> from Cargo.toml, then the number
# of commits as the patch, so each master build upgrades the last. Bump
# Cargo.toml's version for a new major or minor. History must never be
# squashed or rewritten to fewer commits: the number would go backwards.
# Needs the full history (fetch-depth: 0) to count commits.
set -e
cd "$(dirname "$0")/.."
base="$(sed -n 's/^version = "\([0-9]*\.[0-9]*\)\..*/\1/p' Cargo.toml | head -n1)"
echo "$base.$(git rev-list --count HEAD)"
