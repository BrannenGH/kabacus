{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kabacus",
  "version": "0.2.0",
  "identifier": "me.hallb.kabacus.web",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build-desktop-cli.mjs && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "kabacus"
        ],
        "mimeType": "application/x-kabacus",
        "name": "Kabacus books",
        "role": "Editor"
      }
    ]
  }
}
